; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hole"
run/main_scene="uid://dmlxku3cybh56"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://Scripts/GameConfig.gd"
MetaManager="*res://Scripts/MetaManager.gd"
Events="*res://Scripts/Events.gd"
GachaManager="*res://Scripts/GachaManager.gd"
MissionManager="*res://Scripts/MissionManager.gd"
RoguelikeUpgradeManager="*res://Scripts/RoguelikeUpgradeManager.gd"

[display]

window/size/viewport_height=1280
window/stretch/aspect="expand"
#Mobileportraitbaselinewindow/size/viewport_width=720
#Avoidnon-uniformstretching(keepscirclescircularacrossdevices)window/stretch/mode="canvas_items"
#Preferportraitonhandhelddeviceswindow/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
#Avoidgraybordersshowingthroughifanythingisuncoveredenvironment/defaults/default_clear_color=Color(0, 0, 0, 1)
